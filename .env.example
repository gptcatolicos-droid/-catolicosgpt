# Dirección pública canónica, sin barra final.
APP_URL=https://www.catolicosgpt.com
PORT=3000
NODE_ENV=production

# Magisterium es la fuente doctrinal primaria del nuevo agente.
# Obtén la clave desde tu cuenta autorizada de Magisterium; nunca la expongas
# en HTML, JavaScript del navegador ni en un repositorio.
MAGISTERIUM_API_KEY=
MAGISTERIUM_API_BASE=https://www.magisterium.com/api/v1
MAGISTERIUM_MODEL=magisterium-1
MAGISTERIUM_TIMEOUT_MS=45000

# OpenAI es opcional y sólo edita la presentación de texto que Magisterium ya
# produjo. Si no hay respuesta de Magisterium, no se llama a OpenAI.
OPENAI_API_KEY=
# Opcional para un proxy compatible de OpenAI; en producción deja el valor oficial.
# OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_PRESENTATION_ENABLED=1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_TIMEOUT_MS=45000
OPENAI_MAX_PROMPT_CHARS=16000
OPENAI_MAX_OUTPUT_TOKENS=1100

# Integración heredada: sigue siendo opcional para rutas internas existentes.
GEMINI_API_KEY=

# Usa un secreto largo y único en producción para las sesiones existentes.
JWT_SECRET=replace-with-a-long-random-secret

# Opcional: directorio persistente para los catálogos locales existentes.
# DATA_DIR=/var/lib/catolicosgpt/data
